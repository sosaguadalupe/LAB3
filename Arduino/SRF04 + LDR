// Arduino MEGA esclavo 
#include <Wire.h>

const uint8_t I2C_ADDR = 0x08;
const uint8_t PIN_LDR  = A0;
const uint8_t PIN_TRIG = 22;
const uint8_t PIN_ECHO = 23;

// Intervalos configurables (ms): [0]=LDR, [1]=SRF04
volatile uint16_t intervalo[2] = {1000, 500};

// Promedio móvil del LDR (filtro en el borde)
const uint8_t N_LDR = 8;
uint16_t bufLdr[N_LDR];
uint8_t  idxLdr = 0;
bool     bufLleno = false;

// Valores a publicar
volatile uint16_t ldrProm = 0;   // cuentas ADC (0-1023)
volatile uint16_t distMm  = 0;   // mm (0 = sin eco válido)

unsigned long tLdr = 0, tSrf = 0;

// Máquina de estados del SRF04 (no bloqueante)
enum EstadoSrf { SRF_IDLE, SRF_TRIG, SRF_ESPERA_ECHO, SRF_MIDE_ECHO };
EstadoSrf estSrf = SRF_IDLE;
unsigned long tTrig = 0, tEchoIni = 0;

void setup() {
  Serial.begin(115200);
  pinMode(PIN_TRIG, OUTPUT);
  pinMode(PIN_ECHO, INPUT);
  digitalWrite(PIN_TRIG, LOW);

  Wire.begin(I2C_ADDR);
  // Wire activa pull-ups internos a 5 V: se desactivan porque el ESP8266 es de 3.3 V.
  // Usar pull-ups externos de 4.7k a 3.3V.
  digitalWrite(SDA, LOW);
  digitalWrite(SCL, LOW);
  Wire.onReceive(alRecibir);
  Wire.onRequest(alPedir);
}

void loop() {
  unsigned long ahora = millis();

  // --- LDR ---
  if (ahora - tLdr >= intervalo[0]) {
    tLdr = ahora;
    bufLdr[idxLdr] = analogRead(PIN_LDR);
    idxLdr = (idxLdr + 1) % N_LDR;
    if (idxLdr == 0) bufLleno = true;
    uint8_t n = bufLleno ? N_LDR : idxLdr;
    if (n == 0) n = 1;
    uint32_t suma = 0;
    for (uint8_t i = 0; i < n; i++) suma += bufLdr[i];
    ldrProm = suma / n;
  }

  // SRF04: dispara cada intervalo[1] 
  switch (estSrf) {
    case SRF_IDLE:
      if (ahora - tSrf >= intervalo[1]) {
        tSrf = ahora;
        digitalWrite(PIN_TRIG, HIGH);
        tTrig = micros();
        estSrf = SRF_TRIG;
      }
      break;
    case SRF_TRIG:
      if (micros() - tTrig >= 10) {
        digitalWrite(PIN_TRIG, LOW);
        tTrig = micros();
        estSrf = SRF_ESPERA_ECHO;
      }
      break;
    case SRF_ESPERA_ECHO:
      if (digitalRead(PIN_ECHO)) {
        tEchoIni = micros();
        estSrf = SRF_MIDE_ECHO;
      } else if (micros() - tTrig > 30000UL) {
        distMm = 0; estSrf = SRF_IDLE;      // sin eco
      }
      break;
    case SRF_MIDE_ECHO:
      if (!digitalRead(PIN_ECHO)) {
        unsigned long dt = micros() - tEchoIni;
        distMm = (uint16_t)(dt * 0.1715f);  // v=343 m/s, ida y vuelta
        estSrf = SRF_IDLE;
      } else if (micros() - tEchoIni > 30000UL) {
        distMm = 0; estSrf = SRF_IDLE;
      }
      break;
  }
}

// ESP - Mega: [cmd=0x01][sensor][lo][hi]  (fija intervalo en ms)
void alRecibir(int n) {
  if (n < 4) { while (Wire.available()) Wire.read(); return; }
  uint8_t cmd = Wire.read();
  uint8_t s   = Wire.read();
  uint16_t v  = Wire.read();
  v |= (uint16_t)Wire.read() << 8;
  if (cmd == 0x01 && s < 2 && v >= 50) intervalo[s] = v;
}

// Mega - ESP: 8 bytes = ldr, distMm, intLdr, intSrf (uint16 little-endian)
void alPedir() {
  uint16_t d[4] = {ldrProm, distMm, intervalo[0], intervalo[1]};
  Wire.write((uint8_t*)d, 8);
}
